{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "chrome",
			"request": "launch",
			"name": "Debug Webdesk",
			"url": "http://localhost:80",
			"webRoot": "${workspaceFolder}",
			"userDataDir": "${workspaceFolder}/.chrome-profile",
			"preLaunchTask": "Run Server - Windows",
			"runtimeArgs": [
				"--auto-open-devtools-for-tabs"
			]
		}
	]
}